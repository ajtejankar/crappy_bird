# Copy to .env for local dev (the app reads real env vars; use `env $(cat .env | xargs)` or direnv).
# NEVER commit .env.

# Where the app lives (used for Stripe redirect URLs). No trailing slash.
APP_BASE_URL=http://localhost:8080

# --- Stripe (leave both unset for local dev -> fake "dev pay" mode is enabled) ---
# Secret key: Stripe dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=
# Webhook signing secret: Stripe dashboard -> Developers -> Webhooks -> your endpoint
STRIPE_WEBHOOK_SECRET=

# --- The dev cycle ---
# Shared secret between the web app and the GitHub Actions workflow. Generate with:
#   openssl rand -hex 32
AGENT_TOKEN=
# GitHub repo that holds this code + game versions, e.g. yourname/crappy-bird
GITHUB_REPO=
GITHUB_BRANCH=main
# Fine-grained PAT with Actions:write + Contents:read on that repo (used to dispatch the workflow)
GITHUB_PAT=

# --- Tunables ---
# Dollars (in cents) the war chest must reach before the AI developer wakes up
FUND_THRESHOLD_CENTS=1000
# Probability a death triggers the extortion overlay (0..1)
BLOCK_PROBABILITY=0.35
# SQLite location (on Fly this should be /data/crappy.db, on the mounted volume)
DB_PATH=data/crappy.db
