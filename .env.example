# Copy to .env for local dev (the app reads real env vars; use `env $(cat .env | xargs)` or direnv).
# NEVER commit .env.
#
# There are no payment keys because there are no payments. This is permanent.

# Where the app lives. No trailing slash.
APP_BASE_URL=http://localhost:8080

# --- The dev cycle ---
# Shared secret between the web app and the GitHub Actions workflow. Generate with:
#   openssl rand -hex 32
AGENT_TOKEN=
# GitHub repo that holds this code + game versions, e.g. yourname/crappy-bird.
# Leave GITHUB_REPO/GITHUB_PAT unset for local dev -> DEV MODE: summons are simulated.
GITHUB_REPO=
GITHUB_BRANCH=main
# Fine-grained PAT with Actions:write only on that repo (used to dispatch the workflow)
GITHUB_PAT=

# --- The capacity ledger (mirrors Claude Pro reality, conservatively) ---
# Rolling usage window, in hours, and how many agent runs fit in one
WINDOW_HOURS=5
RUNS_PER_WINDOW=1
# Weekly run budget (generous launch pacing; collisions teach the ledger the truth)
RUNS_PER_WEEK=8

# --- App constants (agent-tunable knobs live in the DB, not here) ---
# Below this sample size the dossier flags numbers as gossip
MIN_SAMPLE=30
# Telemetry flood ceiling per IP per day
PLAYS_PER_DAY=1000
# SQLite location (on Fly this should be /data/crappy.db, on the mounted volume)
DB_PATH=data/crappy.db
